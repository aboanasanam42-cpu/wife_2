# ==============================================================================
# MEXC Spot Multi-Slot Multi-Pair Bot (24/7 Railway Worker Configuration - wife_2)
# Production Multi-Pair Scanner Engine & Variable Alignment
# ==============================================================================

# MEXC Spot API Credentials (Spot trade permissions ONLY - NO Withdrawals!)
MEXC_API_KEY=mx0vglYourMexcApiKeyHere
MEXC_API_SECRET=yourMexcApiSecretKeyHere

# Telegram Notification Bot (Instant mobile execution alerts)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# Trading Pair Execution Loop (Dedicated BTC/USDT Focus)
# Pair Mapping: reads pair from TRADE_SYMBOL or legacy PAIR (defaults strictly to BTC/USDT)
TRADE_SYMBOL=BTC/USDT
PAIR=BTC/USDT
TIMEFRAME=1m
CHECK_INTERVAL_SECONDS=10

# Multi-Slot Fixed Allocation & Dynamic Scaling
# Slot Sizing: reads SLOT_SIZE_USDT first, fallbacks to TRADE_AMOUNT_USDT
SLOT_SIZE_USDT=4.0
TRADE_AMOUNT_USDT=4.0

# Slot Limits: reads INITIAL_MAX_SLOTS first, fallbacks to MAX_OPEN_TRADES
INITIAL_MAX_SLOTS=2
MAX_OPEN_TRADES=2

# Cash Shield & Anti-Clustering Decoupling (0.006 = 0.6% inter-slot spacing)
CASH_RESERVE_USDT=2.0
MIN_SLOT_PRICE_DIFF_PCT=0.006

# Strategy Indicators (Bollinger Bands %B + Fast RSI + ATR)
BOLLINGER_PERIOD=20
BOLLINGER_STD=2.0
BOLLINGER_B_ENTRY=0.20
RSI_PERIOD=14
RSI_OVERSOLD=38.0
RSI_OVERBOUGHT=68.0
EMA_PERIOD=20
ATR_PERIOD=14

# Per-Slot Independent Exit & Dynamic Trailing Engine (0.005 = +0.5%, 0.002 = 0.2%)
TRAILING_STOP_ACTIVATION_PCT=0.005
TRAILING_STOP_OFFSET_PCT=0.002
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=3.0

# Operational Safety
MAX_SLIPPAGE_PCT=0.005
LOG_LEVEL=INFO
SIMULATION_MODE=False
