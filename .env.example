# ==============================================================================
# MEXC Spot Trading Bot (24/7 Railway Worker Configuration)
# Dynamic Volatility Scalping (Bollinger Bands + RSI + ATR + Trailing Stop)
# ==============================================================================

# MEXC API Credentials (Ensure IP binding or Spot Trade permission only - NO Withdrawals!)
MEXC_API_KEY=mx0vglYourMexcApiKeyHere
MEXC_API_SECRET=yourMexcApiSecretKeyHere

# Telegram Notification Bot (Optional for 24/7 phone alerts)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# Trading Engine Parameters
TRADE_SYMBOL=BTC/USDT
TRADE_AMOUNT_USDT=15.0
TIMEFRAME=15m
CHECK_INTERVAL_SECONDS=30
POLL_INTERVAL_SECONDS=30

# Dynamic Volatility Bands (Bollinger Bands)
BOLLINGER_PERIOD=20
BOLLINGER_STD=2.0

# Momentum Filter (RSI)
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Adaptive Volatility & Dynamic SL (ATR)
ATR_PERIOD=14
ATR_MULTIPLIER_SL=1.5
EMA_PERIOD=20

# Risk Management & Limits
TAKE_PROFIT_PERCENT=2.5
STOP_LOSS_PERCENT=1.5
MAX_OPEN_TRADES=1
MAX_SLIPPAGE_PCT=0.005

# Trailing Take-Profit Engine
TRAILING_STOP_ACTIVATION_PCT=1.0
TRAILING_STOP_OFFSET_PCT=0.5

# Operational Mode
LOG_LEVEL=INFO
SIMULATION_MODE=False
