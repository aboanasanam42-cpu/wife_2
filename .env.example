# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# ==============================================================================
# MEXC Spot Trading Bot (24/7 Railway Worker Configuration)
# ==============================================================================

# MEXC API Credentials (Ensure IP binding or Spot Trade permission only - NO Withdrawals!)
MEXC_API_KEY=mx0vglYourMexcApiKeyHere
MEXC_API_SECRET=yourMexcApiSecretKeyHere

# Telegram Notification Bot (Optional but strongly recommended for 24/7 monitoring)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# Trading Engine Parameters
TRADE_SYMBOL=BTC/USDT
TRADE_AMOUNT_USDT=15.0
TIMEFRAME=15m
CHECK_INTERVAL_SECONDS=30
POLL_INTERVAL_SECONDS=30

# Technical Strategy Parameters (RSI + 20 EMA)
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
EMA_PERIOD=20

# Risk Management & Limits
TAKE_PROFIT_PERCENT=2.5
STOP_LOSS_PERCENT=1.5
MAX_OPEN_TRADES=1
MAX_SLIPPAGE_PCT=0.005
LOG_LEVEL=INFO

# Simulation / Dry Run (True to test strategy with simulated balance, False for live real money execution)
SIMULATION_MODE=False

