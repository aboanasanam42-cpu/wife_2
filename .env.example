# ==============================================================================
# MEXC Spot Multi-Slot Bot (24/7 Railway Worker Configuration)
# Independent Multi-Slot Engine with Dynamic Compounding Expansion
# ==============================================================================

# MEXC Spot API Credentials (Spot trade permissions ONLY - NO Withdrawals!)
MEXC_API_KEY=mx0vglYourMexcApiKeyHere
MEXC_API_SECRET=yourMexcApiSecretKeyHere

# Telegram Notification Bot (Optional for instant mobile execution alerts)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# Trading Symbol & Execution Loop
TRADE_SYMBOL=BTC/USDT
TIMEFRAME=15m
CHECK_INTERVAL_SECONDS=30

# Multi-Slot Fixed Allocation & Dynamic Scaling
SLOT_SIZE_USDT=4.0
INITIAL_MAX_SLOTS=2
CASH_RESERVE_USDT=2.0
MIN_SLOT_PRICE_DIFF_PCT=1.0

# Strategy Indicators (Bollinger Bands + Fast RSI + ATR)
BOLLINGER_PERIOD=20
BOLLINGER_STD=2.0
RSI_PERIOD=14
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0
EMA_PERIOD=20
ATR_PERIOD=14

# Per-Slot Independent Exit & Dynamic Trailing Engine
TRAILING_STOP_ACTIVATION_PCT=1.2
TRAILING_STOP_OFFSET_PCT=0.5
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=3.0

# Operational Safety
MAX_SLIPPAGE_PCT=0.005
LOG_LEVEL=INFO
SIMULATION_MODE=False
