# ==============================================================================
# MEXC Spot Infinity Grid Bot (24/7 Railway Worker Configuration)
# Constant Portfolio Value / Geometric Grid Strategy
# ==============================================================================

# MEXC API Credentials (Ensure Spot Trade permission only - NO Withdrawals!)
MEXC_API_KEY=mx0vglYourMexcApiKeyHere
MEXC_API_SECRET=yourMexcApiSecretKeyHere

# Telegram Notification Bot (Optional for real-time mobile trade alerts)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# Trading Engine Parameters
TRADE_SYMBOL=BTC/USDT
CHECK_INTERVAL_SECONDS=20

# Infinity Grid Strategy Parameters
# Geometric percentage movement between grid executions (e.g. 1.0 for 1.0%)
GRID_STEP_PERCENT=1.0

# Capital Protection: Pause buying if price falls below this safety floor
LOWER_BOUND_PRICE=50000.0

# Constant Target Portfolio Value in USDT (Value of base asset to maintain)
ALLOCATION_USDT=10.0

# Execution & Risk Limits
MAX_SLIPPAGE_PCT=0.005
LOG_LEVEL=INFO

# Simulation Mode (Set to False for Real Spot Trades, True for Dry Run)
SIMULATION_MODE=False
