# ==============================================================================
# MEXC Spot Multi-Slot Bot (24/7 Railway Worker Configuration - wife_2)
# Production Multi-Slot Engine & Harmonized Variable Alignment
# ==============================================================================

# MEXC Spot API Credentials (Spot trade permissions ONLY - NO Withdrawals!)
MEXC_API_KEY=mx0vglYourMexcApiKeyHere
MEXC_API_SECRET=yourMexcApiSecretKeyHere

# Telegram Notification Bot (Instant mobile execution alerts)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# Trading Symbol & Execution Loop (High-frequency scalping)
# Pair Mapping: reads TRADE_SYMBOL first, fallbacks to PAIR
TRADE_SYMBOL=BTC/USDT
PAIR=BTC/USDT
TIMEFRAME=1m
CHECK_INTERVAL_SECONDS=15

# Multi-Slot Fixed Allocation & Dynamic Scaling
# Slot Sizing: reads SLOT_SIZE_USDT first, fallbacks to TRADE_AMOUNT_USDT
SLOT_SIZE_USDT=4.0
TRADE_AMOUNT_USDT=4.0

# Slot Limits: reads INITIAL_MAX_SLOTS first, fallbacks to MAX_OPEN_TRADES
INITIAL_MAX_SLOTS=2
MAX_OPEN_TRADES=2

# Cash Shield & Anti-Clustering Decoupling
CASH_RESERVE_USDT=2.0
MIN_SLOT_PRICE_DIFF_PCT=0.8

# Strategy Indicators (Bollinger Bands %B + Fast RSI + ATR)
BOLLINGER_PERIOD=20
BOLLINGER_STD=2.0
RSI_PERIOD=14
RSI_OVERSOLD=36.0
RSI_OVERBOUGHT=68.0
EMA_PERIOD=20
ATR_PERIOD=14

# Per-Slot Independent Exit & Dynamic Trailing Engine
TRAILING_STOP_ACTIVATION_PCT=0.8
TRAILING_STOP_OFFSET_PCT=0.3
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=3.0

# Operational Safety
MAX_SLIPPAGE_PCT=0.005
LOG_LEVEL=INFO
SIMULATION_MODE=False
